<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> tic tac toc=GAME>..</title>
        <link rel="stylesheet" href="tic.css">

</head>
<body>
    <h1>ROCK PAPER SCISSORS GAME =++</h1> 
    <div class="choices">
        <div class="choice" id="ROCK">
            <img src="https://www.google.com/url?sa=i&url=https%3A%2F%2Fgithub.com%2Fsatvik-tandon%2FStone-Paper-Scissor-Game&psig=AOvVaw3aSEbHtAu_-NJwo91OssQr&ust=1762849071886000&source=images&cd=vfe&opi=89978449&ved=0CBUQjRxqFwoTCPiKka6V55ADFQAAAAAdAAAAABAE" alt="it is ROCK">  
        </div>

         <div class="choice" id="PAPER">
            <img src="https://www.google.com/url?sa=i&url=https%3A%2F%2Fgithub.com%2Fsatvik-tandon%2FStone-Paper-Scissor-Game&psig=AOvVaw3aSEbHtAu_-NJwo91OssQr&ust=1762849071886000&source=images&cd=vfe&opi=89978449&ved=0CBUQjRxqFwoTCPiKka6V55ADFQAAAAAdAAAAABAE" alt="it is PAPER">  
        </div>

         <div class="choice" id="SCISSORS">
            <img src="https://www.google.com/url?sa=i&url=https%3A%2F%2Fgithub.com%2Fsatvik-tandon%2FStone-Paper-Scissor-Game&psig=AOvVaw3aSEbHtAu_-NJwo91OssQr&ust=1762849071886000&source=images&cd=vfe&opi=89978449&ved=0CBUQjRxqFwoTCPiKka6V55ADFQAAAAAdAAAAABAE" alt="it is SCISSORS">  
        </div>

    </div>

    <div class="score-board">
        <div class="score">
            <p id="user-score">0</p>
            <p>YOU</p>
        </div>
         <div class="score">
            <p id="comp-score">0</p>
            <p>Computer</p>
        </div>
    </div>
    <div class="msg-container">
        <p id="msg"> Play YOUR move</p>
    </div>

</body>
<script src="tic.js"></script>
</html>